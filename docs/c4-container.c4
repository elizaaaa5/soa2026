// Specification: C4 Container Diagram
// System: Marketplace Platform

specification {
  element actor
  element system
  element container
  element database
  element externalSystem

  relationship sync
  relationship async
  relationship bidirectional
}

model {
  // External Systems
  customer = actor 'Покупатель/Продавец' {
    description 'Пользователи маркетплейса: покупатели и продавцы'
  }

  paymentGateway = externalSystem 'Payment Gateway' {
    description 'Внешний платежный шлюз для обработки платежей'
    technology 'HTTPS'
  }

  emailProvider = externalSystem 'Email Provider' {
    description 'Внешний провайдер email-сервисов'
    technology 'SMTP'
  }

  // Main System
  marketplace = system 'Marketplace Platform' {
    description 'Платформа маркетплейса'

    // Frontend Layer
    webApp = container 'Web Application' {
      description 'Веб-приложение для браузеров'
      technology 'React / Vue'
      style {
        shape browser
      }
    }

    mobileApp = container 'Mobile Application' {
      description 'Мобильное приложение (iOS/Android)'
      technology 'React Native / Flutter'
      style {
        shape mobile
      }
    }

    // API Gateway
    apiGateway = container 'API Gateway' {
      description 'Единая точка входа для всех API запросов. Обеспечивает аутентификацию, rate limiting, routing.'
      technology 'Nginx / Kong / Envoy'
    }

    // Services
    usersService = container 'Users Service' {
      description 'Микросервис для управления пользователями. Регистрация, аутентификация, авторизация, профили, роли.'
      technology 'FastAPI / Python'
    }

    catalogService = container 'Catalog Service' {
      description 'Микросервис для управления товарным каталогом. Товары, категории, инвентарь, поиск.'
      technology 'FastAPI / Python'
    }

    ordersService = container 'Orders Service' {
      description 'Микросервис для управления заказами и платежами. Заказы, корзина, платежи.'
      technology 'FastAPI / Python'
    }

    notificationsService = container 'Notifications Service' {
      description 'Микросервис для отправки уведомлений. Email, push, SMS, управление шаблонами.'
      technology 'FastAPI / Python'
    }

    recommendationsService = container 'Recommendations Service' {
      description 'Микросервис для рекомендаций и персонализации. ML-алгоритмы, анализ поведения, предсказания.'
      technology 'FastAPI / Python'
    }

    // Message Queue
    messageQueue = container 'Message Queue' {
      description 'Очередь сообщений для асинхронной коммуникации между сервисами. События заказов, поведения пользователей.'
      technology 'RabbitMQ'
    }

    // Databases
    usersDB = database 'Users Database' {
      description 'База данных микросервиса Users Service. Таблицы: users, profiles, roles, sessions.'
      technology 'PostgreSQL'
      style {
        shape storage
      }
    }

    catalogDB = database 'Catalog Database' {
      description 'База данных микросервиса Catalog Service. Таблицы: products, categories, inventory, prices.'
      technology 'PostgreSQL'
      style {
        shape storage
      }
    }

    ordersDB = database 'Orders Database' {
      description 'База данных микросервиса Orders Service. Таблицы: orders, order_items, payments, invoices, carts.'
      technology 'PostgreSQL'
      style {
        shape storage
      }
    }

    notificationsDB = database 'Notifications Database' {
      description 'База данных микросервиса Notifications Service. Таблицы: notifications, templates, delivery_status.'
      technology 'PostgreSQL'
      style {
        shape storage
      }
    }

    recommendationsDB = database 'Recommendations Database' {
      description 'База данных микросервиса Recommendations Service. Таблицы: user_behaviors, recommendations, products_embeddings, models.'
      technology 'PostgreSQL'
      style {
        shape storage
      }
    }
  }

  // Relationships

  // Client -> Frontend
  customer -> marketplace.webApp 'Использует'
  customer -> marketplace.mobileApp 'Использует'

  // Frontend <-> API Gateway (Двунаправленное)
  marketplace.webApp -[bidirectional]-> marketplace.apiGateway 'Синхронное'
  marketplace.mobileApp -[bidirectional]-> marketplace.apiGateway 'Синхронное'

  // API Gateway <-> Services (Двунаправленное)
  marketplace.apiGateway -[bidirectional]-> marketplace.usersService 'Синхронное'
  marketplace.apiGateway -[bidirectional]-> marketplace.catalogService 'Синхронное'
  marketplace.apiGateway -[bidirectional]-> marketplace.ordersService 'Синхронное'
  marketplace.apiGateway -[bidirectional]-> marketplace.notificationsService 'Синхронное'
  marketplace.apiGateway -[bidirectional]-> marketplace.recommendationsService 'Синхронное'

  // Services <-> Databases (Двунаправленное)
  marketplace.usersService -[bidirectional]-> marketplace.usersDB 'Синхронное'
  marketplace.catalogService -[bidirectional]-> marketplace.catalogDB 'Синхронное'
  marketplace.ordersService -[bidirectional]-> marketplace.ordersDB 'Синхронное'
  marketplace.notificationsService -[bidirectional]-> marketplace.notificationsDB 'Синхронное'
  marketplace.recommendationsService -[bidirectional]-> marketplace.recommendationsDB 'Синхронное'

  // Service -> Service (Однонаправленное)
  marketplace.ordersService -> marketplace.catalogService 'Синхронное'
  marketplace.ordersService -> marketplace.usersService 'Синхронное'

  // External Systems (Однонаправленные)
  marketplace.ordersService -> paymentGateway 'Синхронное'
  marketplace.notificationsService -> emailProvider 'Синхронное'

  // Services -> Message Queue (Однонаправленное)
  marketplace.ordersService -> marketplace.messageQueue 'Асинхронное'
  marketplace.catalogService -> marketplace.messageQueue 'Асинхронное'
  marketplace.usersService -> marketplace.messageQueue 'Асинхронное'

  //  Message Queue -> Services (Однонаправленное)
  marketplace.messageQueue -> marketplace.recommendationsService 'Асинхронное'
  marketplace.messageQueue -> marketplace.notificationsService 'Асинхронное'
}

views {
  view index {
    title 'Marketplace Platform - Container View'
    include *
  }

  view frontend of marketplace {
    title 'Frontend Layer'
    include marketplace.webApp, marketplace.mobileApp, marketplace.apiGateway
  }

  view services of marketplace {
    title 'Services Layer'
    include marketplace.usersService, marketplace.catalogService, marketplace.ordersService, marketplace.notificationsService, marketplace.recommendationsService
  }

  view databases of marketplace {
    title 'Databases Layer'
    include marketplace.usersDB, marketplace.catalogDB, marketplace.ordersDB, marketplace.notificationsDB, marketplace.recommendationsDB
  }

  view all_with_db of marketplace {
    title 'Services and Databases with Interactions'
    include marketplace.webApp, marketplace.mobileApp, marketplace.apiGateway,
           marketplace.usersService, marketplace.usersDB,
           marketplace.catalogService, marketplace.catalogDB,
           marketplace.ordersService, marketplace.ordersDB,
           marketplace.notificationsService, marketplace.notificationsDB,
           marketplace.recommendationsService, marketplace.recommendationsDB,
           marketplace.messageQueue

    style marketplace.usersService, marketplace.catalogService,
           marketplace.ordersService, marketplace.notificationsService, marketplace.recommendationsService {
      color amber
    }

    style marketplace.usersDB, marketplace.catalogDB,
           marketplace.ordersDB, marketplace.notificationsDB, marketplace.recommendationsDB {
      color indigo
    }

    style marketplace.apiGateway {
      color green
    }

    style marketplace.messageQueue {
      color red
    }
  }
}
